---
/**
 * Drippy yin-yang cursor: a single slowly spinning disc split into a blue
 * and a red teardrop (classic taijitu construction), with opposite-color
 * dots. The halves stay distinct — mixing is limited to a faint violet
 * seam at the center. At rest, one blue and one red drip grow from the
 * bottom edge and detach as falling droplets; movement warps the whole
 * disc — stretched along its direction of travel on an underdamped
 * spring, so it wobbles back into a circle when the pointer stops —
 * retracts the drips, and spins it faster. Hovering a link pulls
 * both halves toward that link's color. Fine pointers only; disabled for
 * prefers-reduced-motion and touch, where the native cursor remains.
 */
---

<canvas id="liquid-cursor" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById("liquid-cursor") as HTMLCanvasElement;
  const finePointer = window.matchMedia("(pointer: fine)").matches;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && finePointer && !reducedMotion) {
    const ctx = canvas.getContext("2d");
    if (ctx) {
      document.documentElement.classList.add("cursor-active");

      let dpr = 1;
      const resize = () => {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
      };
      resize();
      window.addEventListener("resize", resize, { passive: true });

      const BLUE: [number, number, number] = [31, 63, 166];
      const RED: [number, number, number] = [163, 22, 33];
      const R = 12 * 1.7; // disc radius, keeps the 70%-bigger sizing

      const mouse = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
      let visible = false;

      const body = { x: mouse.x, y: mouse.y, vx: 0, vy: 0, spin: 0 };
      // Droplet dynamics, Rayleigh-style: aerodynamic drag stretches the
      // disc along its motion axis (mode-2 deformation), direction changes
      // slosh it sideways (shear), and when the pointer stops surface
      // tension pulls it back to a circle through underdamped oscillation.
      // The deformation axis has inertia so the wobble keeps pointing
      // along the last real direction of travel instead of jittering.
      const fluid = { s: 0, sv: 0, k: 0, kv: 0, ax: 1, ay: 0, pvx: 0, pvy: 0 };
      const colors = {
        blue: [...BLUE] as [number, number, number],
        red: [...RED] as [number, number, number],
      };

      interface Drip {
        offset: number;
        len: number;
        maxLen: number;
        rate: number;
        color: "blue" | "red";
      }
      const drips: Drip[] = [
        { offset: -0.38, len: 3, maxLen: 26, rate: 0.2, color: "blue" },
        { offset: 0.42, len: 6, maxLen: 34, rate: 0.14, color: "red" },
      ];

      interface Droplet {
        x: number;
        y: number;
        vy: number;
        r: number;
        born: number;
        color: [number, number, number];
      }
      const droplets: Droplet[] = [];

      let hoverColor: [number, number, number] | null = null;
      document.addEventListener("mouseover", (e) => {
        const a = (e.target as Element | null)?.closest("a, button");
        if (a) {
          const rgb = getComputedStyle(a).color.match(/\d+(\.\d+)?/g);
          hoverColor = rgb
            ? ([+rgb[0], +rgb[1], +rgb[2]] as [number, number, number])
            : null;
        } else {
          hoverColor = null;
        }
      });

      document.addEventListener(
        "mousemove",
        (e) => {
          mouse.x = e.clientX;
          mouse.y = e.clientY;
          visible = true;
        },
        { passive: true },
      );
      document.addEventListener("mouseleave", () => (visible = false));
      document.addEventListener("mouseenter", () => (visible = true));

      let alpha = 0;
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      const PI = Math.PI;

      const circle = (x: number, y: number, r: number) => {
        ctx.beginPath();
        ctx.arc(x, y, Math.max(r, 0.1), 0, PI * 2);
        ctx.fill();
      };

      const rgba = (c: [number, number, number], a: number) =>
        `rgba(${Math.round(c[0])},${Math.round(c[1])},${Math.round(c[2])},${a})`;

      const frame = () => {
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        alpha = lerp(alpha, visible ? 1 : 0, 0.12);

        if (alpha > 0.01) {
          body.vx = (body.vx + (mouse.x - body.x) * 0.14) * 0.72;
          body.vy = (body.vy + (mouse.y - body.y) * 0.14) * 0.72;
          body.x += body.vx;
          body.y += body.vy;

          const speed = Math.hypot(body.vx, body.vy);
          body.spin += 0.015 + Math.min(speed * 0.004, 0.08);

          // deformation axis follows real motion only, with inertia
          if (speed > 0.7) {
            const t = Math.min(speed * 0.05, 0.25);
            fluid.ax = lerp(fluid.ax, body.vx / speed, t);
            fluid.ay = lerp(fluid.ay, body.vy / speed, t);
            const n = Math.hypot(fluid.ax, fluid.ay) || 1;
            fluid.ax /= n;
            fluid.ay /= n;
          }
          const axisAngle = Math.atan2(fluid.ay, fluid.ax);

          // mode 2 — drag stretch vs surface tension (underdamped spring)
          fluid.sv += (Math.min(speed / 24, 0.5) - fluid.s) * 0.14;
          fluid.sv *= 0.86;
          fluid.s = Math.max(fluid.s + fluid.sv, -0.24);

          // slosh — sideways acceleration shears the drop, then rings down
          const sideAccel =
            (body.vx - fluid.pvx) * -fluid.ay + (body.vy - fluid.pvy) * fluid.ax;
          fluid.pvx = body.vx;
          fluid.pvy = body.vy;
          fluid.kv += sideAccel * 0.02 - fluid.k * 0.12;
          fluid.kv *= 0.85;
          fluid.k = Math.max(Math.min(fluid.k + fluid.kv, 0.5), -0.5);

          for (let i = 0; i < 3; i++) {
            colors.blue[i] = lerp(colors.blue[i], (hoverColor ?? BLUE)[i], 0.07);
            colors.red[i] = lerp(colors.red[i], (hoverColor ?? RED)[i], 0.07);
          }

          // ---- the yin-yang disc ----
          ctx.save();
          ctx.translate(body.x, body.y);
          // the whole taijitu (halves, dots, seam) deforms under one
          // transform: stretch along the axis of travel, pinch across it
          // (volume roughly conserved), sheared by the slosh mode
          ctx.rotate(axisAngle);
          ctx.scale(1 + fluid.s, 1 / (1 + fluid.s * 0.7));
          ctx.transform(1, 0, fluid.k, 1, 0, 0);
          ctx.rotate(body.spin - axisAngle);

          ctx.fillStyle = rgba(colors.blue, 0.92 * alpha);
          circle(0, 0, R);

          // red teardrop half: outer right arc + two half-radius arcs
          ctx.fillStyle = rgba(colors.red, 0.92 * alpha);
          ctx.beginPath();
          ctx.arc(0, 0, R, -PI / 2, PI / 2, false);
          ctx.arc(0, R / 2, R / 2, PI / 2, -PI / 2, true);
          ctx.arc(0, -R / 2, R / 2, PI / 2, -PI / 2, false);
          ctx.closePath();
          ctx.fill();

          // opposite-color dots
          ctx.fillStyle = rgba(colors.blue, 0.92 * alpha);
          circle(0, R / 2, R * 0.16);
          ctx.fillStyle = rgba(colors.red, 0.92 * alpha);
          circle(0, -R / 2, R * 0.16);

          // the only mixing: a faint violet breath at the seam
          ctx.fillStyle = `rgba(97,42,99,${0.16 * alpha})`;
          circle(0, 0, R * 0.2);
          ctx.restore();

          // ---- drips hang from the bottom in screen space ----
          for (const d of drips) {
            if (speed < 2.5) d.len += d.rate;
            else d.len = Math.max(d.len - speed * 0.12, 3);

            const c = colors[d.color];
            if (d.len > d.maxLen) {
              droplets.push({
                x: body.x + d.offset * R,
                y: body.y + R * 0.55 + d.len,
                vy: 0.4,
                r: R * 0.22,
                born: body.y + R * 0.55 + d.len,
                color: [c[0], c[1], c[2]],
              });
              d.len = 4 + Math.random() * 4;
              d.maxLen = 22 + Math.random() * 16;
            }

            ctx.fillStyle = rgba(c, 0.9 * alpha);
            const dx = body.x + d.offset * R;
            const baseY = body.y + R * 0.45;
            const steps = Math.max(Math.ceil(d.len / (R * 0.3)), 2);
            for (let i = 0; i <= steps; i++) {
              const t = i / steps;
              const r =
                t < 1 ? lerp(R * 0.34, R * 0.16, t) : R * 0.22; // drip head bulb
              circle(dx, baseY + d.len * t, r);
            }
          }

          // detached droplets fall, shrink, fade
          for (let i = droplets.length - 1; i >= 0; i--) {
            const p = droplets[i];
            p.vy += 0.3;
            p.y += p.vy;
            p.r *= 0.985;
            const fade = Math.max(1 - (p.y - p.born) / 140, 0);
            if (fade <= 0.02 || p.r < 0.8) {
              droplets.splice(i, 1);
              continue;
            }
            ctx.fillStyle = rgba(p.color, 0.9 * fade * alpha);
            circle(p.x, p.y, p.r);
          }
          if (droplets.length > 40) droplets.splice(0, droplets.length - 40);

          // crisp dot at the true pointer position, for precision
          ctx.fillStyle = `rgba(19,19,19,${0.95 * alpha})`;
          circle(mouse.x, mouse.y, 4);
        }

        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  }
</script>

<style>
  #liquid-cursor {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9999;
  }

  html:not(.cursor-active) #liquid-cursor {
    display: none;
  }
</style>

<style is:global>
  html.cursor-active,
  html.cursor-active * {
    cursor: none !important;
  }
</style>
