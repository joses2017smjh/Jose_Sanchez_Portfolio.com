---
/**
 * Drippy yin-yang cursor: a disc split into a blue and a red teardrop
 * (classic taijitu construction) held at a fixed orientation — it never
 * spins — with opposite-color dots, its rim a randomly morphing splat of
 * interfering capillary waves whose lobes swell and subside at a
 * lava-lamp pace, with translucent blobs drifting through the disc that
 * mix the two colours where they cross the violet seam. At rest, one blue and one red drip grow from the bottom
 * edge and detach as falling droplets; movement warps the whole disc —
 * stretched along its direction of travel on an underdamped spring, so
 * it wobbles back into a circle when the pointer stops — and retracts
 * the drips. Hovering a link pulls both halves toward that link's color.
 * Fine pointers only; disabled for prefers-reduced-motion and touch,
 * where the native cursor remains.
 */
---

<canvas id="liquid-cursor" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById("liquid-cursor") as HTMLCanvasElement;
  const finePointer = window.matchMedia("(pointer: fine)").matches;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && finePointer && !reducedMotion) {
    const ctx = canvas.getContext("2d");
    if (ctx) {
      document.documentElement.classList.add("cursor-active");

      let dpr = 1;
      const resize = () => {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
      };
      resize();
      window.addEventListener("resize", resize, { passive: true });

      const BLUE: [number, number, number] = [31, 63, 166];
      const RED: [number, number, number] = [163, 22, 33];
      const R = 12 * 1.53; // disc radius (10% down from the 1.7 sizing)

      const mouse = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
      let visible = false;

      const body = { x: mouse.x, y: mouse.y, vx: 0, vy: 0 };
      // Droplet dynamics, Rayleigh-style: aerodynamic drag stretches the
      // disc along its motion axis (mode-2 deformation), direction changes
      // slosh it sideways (shear), and when the pointer stops surface
      // tension pulls it back to a circle through underdamped oscillation.
      // The deformation axis has inertia so the wobble keeps pointing
      // along the last real direction of travel instead of jittering.
      const fluid = { s: 0, sv: 0, k: 0, kv: 0, ax: 1, ay: 0, pvx: 0, pvy: 0 };

      // The rim is a random splat: six capillary waves of different
      // wavelengths travel around the edge at different speeds, and each
      // wave's amplitude keeps drifting toward a freshly rolled random
      // target — so the blob never settles into a regular pattern; lobes
      // grow, shrink, merge and split like a splash. The amplitude budget
      // is capped so fingers always stay inside the painted disc.
      // Movement agitates the water: waves run faster and taller.
      // Low wave numbers and slow drift give big rounded lobes that swell
      // and subside like a lava lamp, rather than a fast spiky splash.
      const RIPPLE = [
        { k: 2, a: 0.05, t: 0.05, w: 0.008, p: 5.1 },
        { k: 3, a: 0.055, t: 0.055, w: 0.011, p: 0 },
        { k: 4, a: 0.045, t: 0.045, w: -0.014, p: 2.1 },
        { k: 5, a: 0.03, t: 0.03, w: 0.017, p: 3.3 },
        { k: 7, a: 0.02, t: 0.02, w: -0.021, p: 4.2 },
        { k: 9, a: 0.012, t: 0.012, w: 0.027, p: 1.3 },
      ];
      const RIM_SEGMENTS = 72;
      let splatTimer = 0;

      // Lava-lamp interior: slow translucent bodies rising and sinking
      // through the disc. Where one drifts across the seam its colour
      // lays over the other half, so blue and red mix as they pass.
      const LAVA = [
        { color: "red" as const, ph: 0.0, sp: 0.0055, sway: 0.31, seed: 0.0 },
        { color: "blue" as const, ph: 2.4, sp: -0.0041, sway: 0.27, seed: 1.7 },
        { color: "red" as const, ph: 4.1, sp: 0.0032, sway: 0.22, seed: 3.4 },
      ];
      const colors = {
        blue: [...BLUE] as [number, number, number],
        red: [...RED] as [number, number, number],
      };

      interface Drip {
        offset: number;
        len: number;
        maxLen: number;
        rate: number;
        color: "blue" | "red";
      }
      const drips: Drip[] = [
        { offset: -0.38, len: 3, maxLen: 26, rate: 0.2, color: "blue" },
        { offset: 0.42, len: 6, maxLen: 34, rate: 0.14, color: "red" },
      ];

      interface Droplet {
        x: number;
        y: number;
        vy: number;
        r: number;
        born: number;
        color: [number, number, number];
      }
      const droplets: Droplet[] = [];

      let hoverColor: [number, number, number] | null = null;
      document.addEventListener("mouseover", (e) => {
        const a = (e.target as Element | null)?.closest("a, button");
        if (a) {
          const rgb = getComputedStyle(a).color.match(/\d+(\.\d+)?/g);
          hoverColor = rgb
            ? ([+rgb[0], +rgb[1], +rgb[2]] as [number, number, number])
            : null;
        } else {
          hoverColor = null;
        }
      });

      document.addEventListener(
        "mousemove",
        (e) => {
          mouse.x = e.clientX;
          mouse.y = e.clientY;
          visible = true;
        },
        { passive: true },
      );
      document.addEventListener("mouseleave", () => (visible = false));
      document.addEventListener("mouseenter", () => (visible = true));

      let alpha = 0;
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      const PI = Math.PI;

      const circle = (x: number, y: number, r: number) => {
        ctx.beginPath();
        ctx.arc(x, y, Math.max(r, 0.1), 0, PI * 2);
        ctx.fill();
      };

      const rgba = (c: [number, number, number], a: number) =>
        `rgba(${Math.round(c[0])},${Math.round(c[1])},${Math.round(c[2])},${a})`;

      const frame = () => {
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        alpha = lerp(alpha, visible ? 1 : 0, 0.12);

        if (alpha > 0.01) {
          body.vx = (body.vx + (mouse.x - body.x) * 0.14) * 0.72;
          body.vy = (body.vy + (mouse.y - body.y) * 0.14) * 0.72;
          body.x += body.vx;
          body.y += body.vy;

          const speed = Math.hypot(body.vx, body.vy);

          // deformation axis follows real motion only, with inertia
          if (speed > 0.7) {
            const t = Math.min(speed * 0.05, 0.25);
            fluid.ax = lerp(fluid.ax, body.vx / speed, t);
            fluid.ay = lerp(fluid.ay, body.vy / speed, t);
            const n = Math.hypot(fluid.ax, fluid.ay) || 1;
            fluid.ax /= n;
            fluid.ay /= n;
          }
          const axisAngle = Math.atan2(fluid.ay, fluid.ax);

          // mode 2 — drag stretch vs surface tension (underdamped spring)
          fluid.sv += (Math.min(speed / 24, 0.5) - fluid.s) * 0.14;
          fluid.sv *= 0.86;
          fluid.s = Math.max(fluid.s + fluid.sv, -0.24);

          // slosh — sideways acceleration shears the drop, then rings down
          const sideAccel =
            (body.vx - fluid.pvx) * -fluid.ay + (body.vy - fluid.pvy) * fluid.ax;
          fluid.pvx = body.vx;
          fluid.pvy = body.vy;
          fluid.kv += sideAccel * 0.02 - fluid.k * 0.12;
          fluid.kv *= 0.85;
          fluid.k = Math.max(Math.min(fluid.k + fluid.kv, 0.5), -0.5);

          for (let i = 0; i < 3; i++) {
            colors.blue[i] = lerp(colors.blue[i], (hoverColor ?? BLUE)[i], 0.07);
            colors.red[i] = lerp(colors.red[i], (hoverColor ?? RED)[i], 0.07);
          }

          // ---- the yin-yang disc ----
          ctx.save();
          ctx.translate(body.x, body.y);
          // the whole taijitu (halves, dots, seam) deforms under one
          // transform: stretch along the axis of travel, pinch across it
          // (volume roughly conserved), sheared by the slosh mode
          ctx.rotate(axisAngle);
          ctx.scale(1 + fluid.s, 1 / (1 + fluid.s * 0.7));
          ctx.transform(1, 0, fluid.k, 1, 0, 0);
          // back to screen frame: the taijitu holds a fixed orientation,
          // only the deformation tracks the direction of travel
          ctx.rotate(-axisAngle);

          // jagged splat rim, clipped over the disc; straight segments
          // between samples keep the edge sharp rather than glassy
          const agitation = 1 + Math.min(speed * 0.03, 0.4);
          if (--splatTimer <= 0) {
            splatTimer = 90 + Math.random() * 180;
            let budget = 0;
            for (const m of RIPPLE) {
              m.t = 0.01 + Math.random() * 0.08;
              budget += m.t;
            }
            const cap = 0.22 / Math.max(budget, 0.22);
            for (const m of RIPPLE) m.t *= cap;
          }
          for (const m of RIPPLE) {
            m.a = lerp(m.a, m.t, 0.012); // slow swell, lava-lamp pace
            m.p += m.w * (1 + Math.min(speed * 0.04, 2.5));
          }
          ctx.beginPath();
          for (let i = 0; i <= RIM_SEGMENTS; i++) {
            const th = (i / RIM_SEGMENTS) * PI * 2;
            let rr = 1;
            for (const m of RIPPLE) rr += m.a * agitation * Math.sin(m.k * th + m.p);
            const rad = R * 1.06 * rr;
            if (i === 0) ctx.moveTo(Math.cos(th) * rad, Math.sin(th) * rad);
            else ctx.lineTo(Math.cos(th) * rad, Math.sin(th) * rad);
          }
          ctx.closePath();
          ctx.clip();
          // taijitu overfills the rim so splat fingers stay colored
          ctx.scale(1.42, 1.42);

          ctx.fillStyle = rgba(colors.blue, 0.92 * alpha);
          circle(0, 0, R);

          // red teardrop half: outer right arc + two half-radius arcs
          ctx.fillStyle = rgba(colors.red, 0.92 * alpha);
          ctx.beginPath();
          ctx.arc(0, 0, R, -PI / 2, PI / 2, false);
          ctx.arc(0, R / 2, R / 2, PI / 2, -PI / 2, true);
          ctx.arc(0, -R / 2, R / 2, PI / 2, -PI / 2, false);
          ctx.closePath();
          ctx.fill();

          // opposite-color dots
          ctx.fillStyle = rgba(colors.blue, 0.92 * alpha);
          circle(0, R / 2, R * 0.16);
          ctx.fillStyle = rgba(colors.red, 0.92 * alpha);
          circle(0, -R / 2, R * 0.16);

          // lava-lamp bodies: slow translucent blobs rising and sinking
          // through the disc, mixing the two colours as they cross over
          for (const g of LAVA) {
            g.ph += g.sp;
            const gx = Math.sin(g.ph * 0.7 + g.seed) * R * g.sway;
            const gy = Math.sin(g.ph) * R * 0.5;
            const gr = R * (0.34 + 0.1 * Math.sin(g.ph * 1.6 + g.seed));
            ctx.fillStyle = rgba(
              g.color === "blue" ? colors.blue : colors.red,
              0.32 * alpha,
            );
            circle(gx, gy, gr);
          }

          // soften the seam: a violet band where the halves meet
          const seam = ctx.createLinearGradient(-R * 0.55, 0, R * 0.55, 0);
          seam.addColorStop(0, "rgba(97,42,99,0)");
          seam.addColorStop(0.5, `rgba(97,42,99,${0.3 * alpha})`);
          seam.addColorStop(1, "rgba(97,42,99,0)");
          ctx.fillStyle = seam;
          circle(0, 0, R);
          ctx.restore();

          // ---- drips: one continuous column of liquid leaving the disc ----
          // The column is the envelope of densely overlapping circles, so
          // its outline is a smooth curve rather than a visible chain of
          // beads. It is anchored inside the disc, and a surface-tension
          // neck thins just above the head until the head pinches off.
          for (const d of drips) {
            if (speed < 2.5) d.len += d.rate;
            else d.len = Math.max(d.len - speed * 0.12, 3);

            const c = colors[d.color];
            const stretch = Math.min(d.len / d.maxLen, 1);
            const dx = body.x + d.offset * R;
            const headY = body.y + R * 0.5 + d.len;
            const headR = lerp(R * 0.15, R * 0.26, stretch);

            if (stretch >= 1) {
              // pinch-off: the head leaves with the filament it snapped from
              droplets.push({
                x: dx,
                y: headY,
                vy: 0.5,
                r: headR,
                tail: R * 0.7,
                born: headY,
                color: [c[0], c[1], c[2]],
              });
              d.len = 3 + Math.random() * 4;
              d.maxLen = 22 + Math.random() * 16;
              continue;
            }

            ctx.fillStyle = rgba(c, 0.92 * alpha);
            const topY = body.y + R * 0.1;
            const span = headY - topY;
            const steps = Math.max(Math.ceil(span / (R * 0.07)), 8);
            for (let i = 0; i <= steps; i++) {
              const t = i / steps;
              // fat where it leaves the body, tapering toward the head
              const taper = lerp(R * 0.42, headR * 0.66, Math.min(t * 1.15, 1));
              // gaussian neck just above the head, deepening as it stretches
              const z = (t - 0.82) / 0.2;
              const neck = 1 - 0.55 * stretch * Math.exp(-z * z);
              circle(dx, topY + span * t, taper * neck);
            }
            circle(dx, headY, headR);
          }

          // detached droplets fall, stretch with speed, and fade
          for (let i = droplets.length - 1; i >= 0; i--) {
            const p = droplets[i];
            p.vy += 0.3;
            p.y += p.vy;
            p.r *= 0.99;
            p.tail = Math.max(p.tail - 1.1, 0); // the filament snaps back
            const fade = Math.max(1 - (p.y - p.born) / 140, 0);
            if (fade <= 0.02 || p.r < 0.8) {
              droplets.splice(i, 1);
              continue;
            }
            ctx.fillStyle = rgba(p.color, 0.9 * fade * alpha);
            // retracting filament above the head
            if (p.tail > 0.5) {
              const steps = Math.max(Math.ceil(p.tail / (R * 0.07)), 3);
              for (let j = 0; j <= steps; j++) {
                const t = j / steps;
                circle(p.x, p.y - p.tail * t, lerp(p.r * 0.8, p.r * 0.12, t));
              }
            }
            // freefall elongates the head along its fall
            const e = Math.min(p.vy * 0.014, 0.3);
            ctx.beginPath();
            ctx.ellipse(p.x, p.y, p.r / (1 + e), p.r * (1 + e), 0, 0, PI * 2);
            ctx.fill();
          }
          if (droplets.length > 40) droplets.splice(0, droplets.length - 40);

          // crisp dot at the true pointer position, for precision
          ctx.fillStyle = `rgba(19,19,19,${0.95 * alpha})`;
          circle(mouse.x, mouse.y, 4);
        }

        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  }
</script>

<style>
  #liquid-cursor {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9999;
  }

  html:not(.cursor-active) #liquid-cursor {
    display: none;
  }
</style>

<style is:global>
  html.cursor-active,
  html.cursor-active * {
    cursor: none !important;
  }
</style>
