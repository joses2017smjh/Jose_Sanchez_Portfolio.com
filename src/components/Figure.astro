---
/**
 * The figure system: every visual on the site is a numbered figure with a
 * mono caption, like a well-set paper. Numbers come from project order.
 */
interface Props {
  number: number;
  video?: string | undefined;
  poster?: string | undefined;
  image?: string | undefined;
  /** Two clips side by side in one frame; wins over `image` when set. */
  pair?: readonly { image: string; alt: string }[] | undefined;
  /** Seconds into the clip to begin (and loop back to). */
  start?: number | undefined;
  alt: string;
  caption: string;
  /** Eager-load only the hero figure on a detail page. */
  eager?: boolean;
  /** Make the media itself a link (the caption stays plain text). */
  href?: string | undefined;
}

const {
  number,
  video,
  poster,
  image,
  pair,
  start,
  alt,
  caption,
  eager = false,
  href,
} = Astro.props;
const label = `FIG. ${String(number).padStart(2, "0")}`;
const Media = href ? "a" : "div";
---

<figure class="figure">
  <div class="figure-rule" aria-hidden="true">
    <span class="figure-number">{label}</span>
  </div>
  <Media class:list={["figure-media", pair && "figure-pair"]} href={href}>
    {
      pair ? (
        pair.map((item) => (
          <img
            src={item.image}
            alt={item.alt}
            loading={eager ? "eager" : "lazy"}
            decoding="async"
            width="560"
            height="440"
          />
        ))
      ) : video ? (
        <video
          data-loop
          data-start={start}
          playsinline
          muted
          {/* a start offset needs metadata up front so the first painted
              frame is already the trimmed one, not frame zero */}
          preload={start ? "metadata" : "none"}
          poster={poster}
          aria-label={alt}
        >
          <source src={video} type={video.endsWith(".webm") ? "video/webm" : "video/mp4"} />
        </video>
      ) : (
        <img
          src={image}
          alt={alt}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          width="1280"
          height="720"
        />
      )
    }
  </Media>
  <figcaption>{label} — {caption}</figcaption>
</figure>
