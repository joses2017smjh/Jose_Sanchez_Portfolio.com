---
/**
 * The figure system: every visual on the site is a numbered figure with a
 * mono caption, like a well-set paper. Numbers come from project order.
 */
interface Props {
  number: number;
  video?: string | undefined;
  poster?: string | undefined;
  image?: string | undefined;
  /** Two clips side by side in one frame; wins over `image` when set. */
  pair?:
    | readonly {
        image: string;
        alt: string;
        poster?: string | undefined;
        outcome?: "pass" | "fail" | undefined;
        tag?: string | undefined;
      }[]
    | undefined;
  alt: string;
  caption: string;
  /** Eager-load only the hero figure on a detail page. */
  eager?: boolean;
  /** Make the media itself a link (the caption stays plain text). */
  href?: string | undefined;
}

const {
  number,
  video,
  poster,
  image,
  pair,
  alt,
  caption,
  eager = false,
  href,
} = Astro.props;
const label = `FIG. ${String(number).padStart(2, "0")}`;
// Keep native video controls outside links; the case-study link remains below.
const mediaHref = video || pair ? undefined : href;
const Media = mediaHref ? "a" : "div";
---

<figure class="figure">
  <div class="figure-rule" aria-hidden="true">
    <span class="figure-number">{label}</span>
  </div>
  <Media class:list={["figure-media", pair && "figure-pair"]} href={mediaHref}>
    {
      pair ? (
        /* demo clips ship as mp4 — hardware decoded, and paused when
           off-screen, which an animated GIF can never be */
        pair.map((item) => {
          /* The tag is not decoration: colour alone would leave the
             outcome invisible to anyone who cannot see the red frame. */
          const tag =
            item.tag ??
            (item.outcome === "fail"
              ? "Failure"
              : item.outcome === "pass"
                ? "Scored fold"
                : undefined);
          return (
            <div
              class:list={["pair-item", item.outcome && `pair-${item.outcome}`]}
            >
              {item.image.endsWith(".mp4") ? (
                <video
                  controls
                  data-loop
                  playsinline
                  muted
                  preload="none"
                  poster={item.poster}
                  aria-label={item.alt}
                >
                  <source src={item.image} type="video/mp4" />
                </video>
              ) : (
                <img
                  src={item.image}
                  alt={item.alt}
                  loading={eager ? "eager" : "lazy"}
                  decoding="async"
                  width="480"
                  height="520"
                />
              )}
              {tag && <span class="pair-tag">{tag}</span>}
            </div>
          );
        })
      ) : video ? (
        <video
          controls
          data-loop
          playsinline
          muted
          preload="none"
          poster={poster}
          aria-label={alt}
        >
          <source src={video} type={video.endsWith(".webm") ? "video/webm" : "video/mp4"} />
        </video>
      ) : (
        <img
          src={image}
          alt={alt}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          width="1280"
          height="720"
        />
      )
    }
  </Media>
  <figcaption>{label} — {caption}</figcaption>
</figure>
