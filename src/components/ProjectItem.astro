---
import type { CollectionEntry } from "astro:content";
import Figure from "./Figure.astro";
import TagList from "./TagList.astro";

interface Props {
  project: CollectionEntry<"projects">;
  /** 1-based position in the sorted list; doubles as the figure number. */
  number: number;
}

const { project, number } = Astro.props;
const {
  title,
  summary,
  tags,
  repo,
  date,
  video,
  cardVideo,
  poster,
  image,
  pair,
  alt,
  figcaption,
} = project.data;
const href = `/projects/${project.id}`;
---

<li>
  <article>
    <Figure
      number={number}
      video={cardVideo ?? video}
      poster={poster}
      image={image}
      pair={pair}
      alt={alt}
      caption={figcaption}
      href={href}
    />
    <div class="project-row">
      <h3 class="project-title"><a href={href}>{title}</a></h3>
      <span class="leader" aria-hidden="true"></span>
      <span class="meta">{date.getUTCFullYear()}</span>
    </div>
    <p class="project-summary">{summary}</p>
    <TagList tags={tags} />
    <div class="project-links">
      {repo && <a href={repo}>GitHub</a>}
      <a href={href}>Details</a>
    </div>
  </article>
</li>
