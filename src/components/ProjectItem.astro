---
import type { CollectionEntry } from "astro:content";
import Figure from "./Figure.astro";
import TagList from "./TagList.astro";

interface Props {
  project: CollectionEntry<"projects">;
  /** 1-based position in the sorted list; doubles as the figure number. */
  number: number;
}

const { project, number } = Astro.props;
const { title, summary, tags, repo, video, poster, image, alt, figcaption } =
  project.data;
const href = `/projects/${project.id}`;
---

<li>
  <article>
    <h3 class="project-title"><a href={href}>{title}</a></h3>
    <p class="project-summary">{summary}</p>
    <Figure
      number={number}
      video={video}
      poster={poster}
      image={image}
      alt={alt}
      caption={figcaption}
    />
    <TagList tags={tags} />
    <div class="project-links">
      <a href={repo}>GitHub</a>
      <a href={href}>Details</a>
    </div>
  </article>
</li>
