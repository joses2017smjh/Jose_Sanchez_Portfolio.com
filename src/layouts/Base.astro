---
import "@fontsource-variable/instrument-sans";
import "@fontsource/fragment-mono";
import "../styles/global.css";
import LiquidCursor from "../components/LiquidCursor.astro";
import { site } from "../site.config";

interface Props {
  title: string;
  description: string;
  /** Full-bleed pages (the panel homepage) skip the centered column. */
  full?: boolean;
}

const { title, description, full = false } = Astro.props;
const path = Astro.url.pathname;
const current = (href: string) =>
  (href === "/" ? path === "/" : path.startsWith(href)) ? "page" : undefined;

// Structured data: what a search engine, an AI assistant, or a recruiter's
// parser reads to answer "who is this and what do they do" without having
// to infer it from prose.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: Astro.site?.toString(),
  email: `mailto:${site.email}`,
  jobTitle: "AI/ML Engineer",
  description: site.positioning,
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Oregon State University",
  },
  knowsAbout: [
    "Computer Vision",
    "3D Perception",
    "Metric Depth Estimation",
    "Point Cloud Classification",
    "Transformers",
    "Retrieval-Augmented Generation",
    "Reinforcement Learning",
    "Robotics",
    "PyTorch",
    "Python",
  ],
  sameAs: site.links
    .filter((l) => l.href.startsWith("http"))
    .map((l) => l.href),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a href="/" aria-current={current("/")}>{site.name}</a>
      <nav aria-label="Site">
        <a href="/#about">About</a>
        <a href="/#projects">Projects</a>
        <a href="/#beyond">Beyond</a>
        <a href="/#resume">Resume</a>
        <a href="/now" aria-current={current("/now")}>Now</a>
      </nav>
    </header>
    <main id="main" class:list={{ full }}>
      <slot />
    </main>
    <LiquidCursor />
    <footer class="site-footer">
      <p class="meta" style="margin: 0;">
        &copy; {new Date().getFullYear()} {site.name}
      </p>
    </footer>

    {/* Videos autoplay only in-viewport and only when motion is welcome. */}
    <script>
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
      const videos = document.querySelectorAll<HTMLVideoElement>("video[data-loop]");
      if (!reduced.matches && videos.length > 0) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const { target, isIntersecting } of entries) {
              const v = target as HTMLVideoElement;
              if (isIntersecting) v.play().catch(() => {});
              else v.pause();
            }
          },
          { rootMargin: "100px" },
        );
        for (const v of videos) {
          v.muted = true;
          v.loop = true;
          io.observe(v);
        }
      } else {
        // Reduced motion: leave the poster frame and offer manual controls.
        for (const v of videos) v.controls = true;
      }
    </script>
  </body>
</html>
