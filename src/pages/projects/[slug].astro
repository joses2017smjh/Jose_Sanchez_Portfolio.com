---
import Base from "../../layouts/Base.astro";
import Figure from "../../components/Figure.astro";
import FigureStrip from "../../components/FigureStrip.astro";
import PaperStrip from "../../components/PaperStrip.astro";
import ScrollRuler from "../../components/ScrollRuler.astro";
import TagList from "../../components/TagList.astro";
import { render } from "astro:content";
import { sortedProjects } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await sortedProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, number: i + 1 },
  }));
}

const { project, number } = Astro.props;
const {
  title,
  summary,
  problem,
  approach,
  contribution,
  result,
  tags,
  repo,
  technicalReadme,
  paper,
  paperStrip,
  diagram,
  links = [],
  demo,
  video,
  poster,
  image,
  pair,
  alt,
  figcaption,
  sections = [],
  gallery,
} = project.data;

// Anything written below the frontmatter renders here, in the order it is
// written — plain markdown, so text and pictures can be reshuffled freely
// without touching a component. See EDITING.md.
const { Content } = await render(project);
const trackAnchor = {
  humanoid: "projects",
  rag: "ai-software",
  vision: "vision-vla",
  hardware: "beyond",
  coursework: "coursework",
}[project.data.track];

// One FIG. NNA…NNZ letter sequence across every strip on the page:
// section strips letter first, the gallery continues after them.
const sectionOffsets: number[] = [];
let letterCount = 0;
for (const s of sections) {
  sectionOffsets.push(letterCount);
  letterCount += s.figures?.length ?? 0;
}
---

<Base title={`${title} — Jose Sanchez Gonzalez`} description={summary}>
  <ScrollRuler />
  <p class="meta"><a href={`/#${trackAnchor}`}>&larr; Selected work</a></p>
  <h1>{title}</h1>
  <p class="detail-summary">{summary}</p>
  <nav class="project-links" aria-label="Project resources">
    {(technicalReadme || repo) && <a href={technicalReadme ?? `${repo}#readme`}>Technical README</a>}
    {repo && <a href={repo}>Source code</a>}
    {demo && <a href={demo}>Watch demo</a>}
    {paper && <a href={paper}>Read paper</a>}
  </nav>

  <Figure
    number={number}
    video={video}
    poster={poster}
    image={image}
    pair={pair}
    alt={alt}
    caption={figcaption}
    eager
  />

  <section class="project-outcome" aria-labelledby="result-title">
    <h2 id="result-title">Result & current limits</h2>
    <p>{result}</p>
  </section>

  <h2>Problem</h2>
  <p>{problem}</p>

  <h2>Solution</h2>
  <p>{approach}</p>

  <h2>What I built</h2>
  <p>{contribution}</p>

  <h2>Technologies</h2>
  <TagList tags={tags} />

  <details class="project-details">
    <summary>More demos, engineering decisions, and evaluation notes</summary>
  {
    diagram && (
      <>
        <h2>Architecture</h2>
        <figure class="diagram">
          <a href={diagram.image} class="diagram-media">
            <img src={diagram.image} alt={diagram.alt} loading="lazy" decoding="async" />
          </a>
          <figcaption>{diagram.caption}</figcaption>
        </figure>
      </>
    )
  }

  {
    sections.map((section, i) => (
      <>
        <h2>{section.heading}</h2>
        {section.body && <p>{section.body}</p>}
        {section.figures && section.figures.length > 0 && (
          <FigureStrip
            number={number}
            items={section.figures}
            letterOffset={sectionOffsets[i]}
          />
        )}
      </>
    ))
  }

  {
    gallery && gallery.length > 0 && (
      <>
        <h2>Figures</h2>
        <FigureStrip number={number} items={gallery} letterOffset={letterCount} />
      </>
    )
  }

  {
    paperStrip && (
      <>
        <h2>Paper</h2>
        <PaperStrip
          pdf={paperStrip.pdf}
          pages={paperStrip.pages}
          count={paperStrip.count}
          title={title}
        />
      </>
    )
  }

  {/* free-form markdown written under the frontmatter, in its own order */}
  <div class="prose">
    <Content />
  </div>
  </details>

  {
    (repo || paper || demo || links.length > 0) && (
      <>
        <h2>Links</h2>
        <div class="project-links">
          {repo && <a href={repo}>GitHub</a>}
          {paper && <a href={paper}>Paper</a>}
          {demo && <a href={demo}>Demo</a>}
          {links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </div>
      </>
    )
  }

  <script>
    // Existing links to MDX headings must reveal their collapsed evidence.
    function revealLinkedEvidence() {
      let id;
      try {
        id = decodeURIComponent(window.location.hash.slice(1));
      } catch {
        return;
      }
      const target = id && document.getElementById(id);
      if (!target) return;

      let ancestor = target.parentElement;
      let opened = false;
      while (ancestor) {
        if (ancestor instanceof HTMLDetailsElement && !ancestor.open) {
          ancestor.open = true;
          opened = true;
        }
        ancestor = ancestor.parentElement;
      }
      if (opened) requestAnimationFrame(() => target.scrollIntoView({ block: "start" }));
    }

    revealLinkedEvidence();
    window.addEventListener("hashchange", revealLinkedEvidence);
  </script>
</Base>
