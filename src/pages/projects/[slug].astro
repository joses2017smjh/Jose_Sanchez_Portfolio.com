---
import Base from "../../layouts/Base.astro";
import Figure from "../../components/Figure.astro";
import FigureStrip from "../../components/FigureStrip.astro";
import PaperStrip from "../../components/PaperStrip.astro";
import ScrollRuler from "../../components/ScrollRuler.astro";
import TagList from "../../components/TagList.astro";
import { sortedProjects } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await sortedProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, number: i + 1 },
  }));
}

const { project, number } = Astro.props;
const {
  title,
  summary,
  problem,
  approach,
  result,
  tags,
  repo,
  paper,
  paperStrip,
  diagram,
  links = [],
  demo,
  video,
  poster,
  image,
  pair,
  alt,
  figcaption,
  sections = [],
  gallery,
} = project.data;

// One FIG. NNA…NNZ letter sequence across every strip on the page:
// section strips letter first, the gallery continues after them.
const sectionOffsets: number[] = [];
let letterCount = 0;
for (const s of sections) {
  sectionOffsets.push(letterCount);
  letterCount += s.figures?.length ?? 0;
}
---

<Base title={`${title} — Jose Sanchez Gonzalez`} description={summary}>
  <ScrollRuler />
  <p class="meta"><a href="/#projects">&larr; Index</a></p>
  <h1>{title}</h1>
  <p class="detail-summary">{summary}</p>

  <Figure
    number={number}
    video={video}
    poster={poster}
    image={image}
    pair={pair}
    alt={alt}
    caption={figcaption}
    eager
  />

  <h2>Problem</h2>
  <p>{problem}</p>

  <h2>Approach</h2>
  <p>{approach}</p>

  <h2>Result</h2>
  <p>{result}</p>

  {
    diagram && (
      <>
        <h2>Architecture</h2>
        <figure class="diagram">
          <a href={diagram.image} class="diagram-media">
            <img src={diagram.image} alt={diagram.alt} loading="lazy" decoding="async" />
          </a>
          <figcaption>{diagram.caption}</figcaption>
        </figure>
      </>
    )
  }

  {
    sections.map((section, i) => (
      <>
        <h2>{section.heading}</h2>
        {section.body && <p>{section.body}</p>}
        {section.figures && section.figures.length > 0 && (
          <FigureStrip
            number={number}
            items={section.figures}
            letterOffset={sectionOffsets[i]}
          />
        )}
      </>
    ))
  }

  {
    gallery && gallery.length > 0 && (
      <>
        <h2>Figures</h2>
        <FigureStrip number={number} items={gallery} letterOffset={letterCount} />
      </>
    )
  }

  {
    paperStrip && (
      <>
        <h2>Paper</h2>
        <PaperStrip
          pdf={paperStrip.pdf}
          pages={paperStrip.pages}
          count={paperStrip.count}
          title={title}
        />
      </>
    )
  }

  <h2>Stack</h2>
  <TagList tags={tags} />

  {
    (repo || paper || demo || links.length > 0) && (
      <>
        <h2>Links</h2>
        <div class="project-links">
          {repo && <a href={repo}>GitHub</a>}
          {paper && <a href={paper}>Paper</a>}
          {demo && <a href={demo}>Demo</a>}
          {links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </div>
      </>
    )
  }
</Base>
