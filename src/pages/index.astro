---
import Base from "../layouts/Base.astro";
import ProjectItem from "../components/ProjectItem.astro";
import { site } from "../site.config";
import { resume } from "../resume.config";
import { sortedProjects } from "../lib/projects";

const projects = await sortedProjects();
const humanoid = projects.filter((p) => p.data.track === "humanoid");
const rag = projects.filter((p) => p.data.track === "rag");
const vision = projects.filter((p) => p.data.track === "vision");
const coursework = projects.filter((p) => p.data.track === "coursework");
---

<Base title={`${site.name} — Robotics, Computer Vision & AI Software`} description={`${site.positioning} ${site.seeking}`} full>
  <div class="portfolio-home">
    <section class="portfolio-hero" id="about" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Jose Sanchez Gonzalez · M.S. Artificial Intelligence</p>
        <h1 id="hero-title">{site.positioning}</h1>
        <p class="hero-role">{site.seeking}</p>
        <p class="hero-intro">Humanoid control, agents that retrieve and use evidence, and vision-guided manipulation. Explore the demos, then follow each result to its code and evaluation.</p>
        <ul class="link-row hero-actions">
          <li><a class="button-link" href="#projects">Humanoid simulation</a></li>
          <li><a class="button-link button-secondary" href="#ai-software">RAG & agents</a></li>
          <li><a class="button-link button-secondary" href="#vision-vla">Computer vision & VLA</a></li>
          <li><a href={resume.links.pdf}>Download résumé <span class="file-type">PDF</span></a></li>
          <li><a href={`mailto:${site.email}`}>Get in touch</a></li>
        </ul>
      </div>
      <aside class="hero-details" aria-label="Project starting points">
        <h2>Start with a demo</h2>
        <ul class="project-starts">
          <li><a href="/projects/humanoid-navigation">Walk through an unfamiliar maze <span aria-hidden="true">&rarr;</span></a><span>Simulated humanoid · lidar mapping · planning</span></li>
          <li><a href="/projects/metanavit">Trace an answer to its source <span aria-hidden="true">&rarr;</span></a><span>Agentic RAG · retrieval evaluation · MCP</span></li>
          <li><a href="/projects/isaac-pruning-workflow">Guide a pruning arm with vision <span aria-hidden="true">&rarr;</span></a><span>RGB-D control · Isaac Sim · contact gates</span></li>
        </ul>
      </aside>
    </section>

    <section class="work-section" id="projects" aria-labelledby="work-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 · Robotics & embodied AI</p>
          <h2 id="work-title">Humanoid Simulation</h2>
        </div>
        <p>Three parts of the same robot system: walk across terrain, navigate a maze, and carry out a language instruction.</p>
      </div>
      <ul class="project-grid project-grid-three">
        {humanoid.map((project) => <ProjectItem project={project} number={projects.indexOf(project) + 1} />)}
      </ul>
    </section>

    <section class="work-section" id="ai-software" aria-labelledby="ai-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 · AI & software engineering</p>
          <h2 id="ai-title">RAG & Agents</h2>
        </div>
        <p>Research-file retrieval and soccer analysis with source tracing, tool calls, and inspectable evaluations.</p>
      </div>
      <ul class="project-grid">
        {rag.map((project) => <ProjectItem project={project} number={projects.indexOf(project) + 1} />)}
      </ul>
    </section>

    <section class="work-section" id="vision-vla" aria-labelledby="vision-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">03 · Perception & manipulation</p>
          <h2 id="vision-title">Computer Vision & VLA</h2>
        </div>
        <p>Vision-language-action policies for folding, RGB-D control for pruning, and metric depth for robotic perception.</p>
      </div>
      <ul class="project-grid project-grid-three">
        {vision.map((project) => <ProjectItem project={project} number={projects.indexOf(project) + 1} />)}
      </ul>
    </section>

    <section class="work-section" id="coursework" aria-labelledby="coursework-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Graduate coursework</p>
          <h2 id="coursework-title">Language and 3D learning</h2>
        </div>
        <p>Model implementations with inspectable predictions and error analysis.</p>
      </div>
      <ul class="supporting-projects">
        {coursework.map((project) => (
          <li>
            <h3><a href={`/projects/${project.id}`}>{project.data.title}</a></h3>
            <p>{project.data.summary}</p>
            <a href={`/projects/${project.id}`}>Results and implementation <span aria-hidden="true">&rarr;</span></a>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-work" id="resume" aria-labelledby="background-title">
      <div>
        <p class="eyebrow">Background</p>
        <h2 id="background-title">Research, implementation, and teaching</h2>
        <p>{site.bio}</p>
        <p>At Oregon State, I led operating systems and computational methods studios and tutored more than 50 students in mathematics and computer science.</p>
        <ul class="link-row">
          <li><a class="button-link" href={resume.links.pdf}>Read my résumé <span class="file-type">PDF</span></a></li>
          {resume.links.variants.map((variant) => (
            <li><a href={variant.href}>{variant.label} <span class="file-type">PDF</span></a></li>
          ))}
          <li><a href={resume.links.linkedin}>LinkedIn</a></li>
          <li><a href="https://github.com/joses2017smjh">GitHub profile</a></li>
        </ul>
      </div>
    </section>

    <section class="beyond-teaser" id="beyond" aria-labelledby="beyond-title">
      <img src="/media/humanoid/26-fully-built-movement.jpg" alt="Fully assembled Berkeley Humanoid Lite hanging from a rack, chest screen on, wiring still external." width="1200" height="1600" loading="lazy" decoding="async" />
      <div>
        <p class="eyebrow">Physical robotics</p>
        <h2 id="beyond-title">Building the hardware, too.</h2>
        <p>From printed parts and actuator calibration to Quest VR arm control. Follow the Berkeley Humanoid Lite build log. Outside the workshop, I hike and train jiu-jitsu.</p>
        <ul class="link-row">
          <li><a href="/projects/berkeley-humanoid-vr">Quest VR arm control <span aria-hidden="true">&rarr;</span></a></li>
          <li><a href="/beyond">The build log and beyond <span aria-hidden="true">&rarr;</span></a></li>
        </ul>
      </div>
    </section>

    <section class="contact-block" id="contact" aria-labelledby="contact-title">
      <p class="eyebrow">Let's talk</p>
      <h2 id="contact-title">Building robots or AI software?</h2>
      <p>I’m looking for engineering roles in robotics, computer vision, embodied AI, and AI software. Let’s talk about the systems your team is building.</p>
      <a class="contact-address" href={`mailto:${site.email}`}>{site.email}</a>
    </section>
  </div>
</Base>
