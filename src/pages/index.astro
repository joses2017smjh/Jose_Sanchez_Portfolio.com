---
import Base from "../layouts/Base.astro";
import ProjectItem from "../components/ProjectItem.astro";
import { site } from "../site.config";
import { sortedProjects } from "../lib/projects";

const projects = await sortedProjects();
---

<Base title={site.name} description={site.positioning}>
  <h1>{site.name}</h1>
  <p class="dim">{site.positioning}</p>
  <p>{site.bio}</p>
  <ul class="link-row">
    {
      site.links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>

  <h2 id="projects">Projects</h2>
  <ul class="project-carousel" aria-labelledby="projects">
    {
      projects.map((project, i) => (
        <ProjectItem project={project} number={i + 1} />
      ))
    }
  </ul>
</Base>
