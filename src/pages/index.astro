---
import Base from "../layouts/Base.astro";
import ProjectItem from "../components/ProjectItem.astro";
import { site } from "../site.config";
import { resume } from "../resume.config";
import { sortedProjects } from "../lib/projects";

const projects = await sortedProjects();
---

<Base title={site.name} description={site.positioning} full>
  <div class="panels" id="panels">
    <section class="panel" id="about" aria-label="About">
      <div class="panel-inner">
        <h1 class="display-name">{site.name}</h1>
        <p class="dim">{site.positioning}</p>
        <p>{site.bio}</p>
        <ul class="link-row">
          {
            site.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="panel" id="projects" aria-label="Projects">
      <div class="panel-cover cover-red" aria-hidden="true">
        <span class="cover-line">PROJECTS</span>
      </div>
      <div class="panel-inner">
        <h2 class="sr-only">Projects</h2>
      </div>
      <ul class="project-carousel">
        {
          projects.map((project, i) => (
            <ProjectItem project={project} number={i + 1} />
          ))
        }
      </ul>
    </section>

    <section class="panel" id="beyond" aria-label="Beyond programming">
      <div class="panel-cover cover-blue" aria-hidden="true">
        <span class="cover-line">BEYOND</span>
        <span class="cover-line">PROGRAMMING</span>
      </div>
      <div class="panel-inner">
        <h2 class="sr-only">Beyond programming</h2>

        <a class="outside-preview" href="/beyond">
          <img
            src="/media/beyond/outside-preview.jpg"
            alt="The Beyond programming page: four tiles — open source robotics, hiking, three dogs, and jiu-jitsu."
            width="1400"
            height="875"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="meta">
          Everything outside the code — the humanoid build, lakes, the dogs,
          the mat: <a href="/beyond">/beyond</a>
        </p>

        <ul class="beyond-list">
          {
            resume.beyond.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p class="dim">{item.body}</p>
              </li>
            ))
          }
        </ul>
        <p class="meta">
          Running log of what I'm building: <a href="/now">/now</a>
        </p>
      </div>
    </section>

    <section class="panel" id="resume" aria-label="Resume">
      <nav class="float-icons" aria-label="Resume links">
        <a href={resume.links.pdf} download title="Download resume PDF">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M8 1v9M4.5 7 8 10.5 11.5 7M2.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="sr-only">Download PDF</span>
        </a>
        <a href={resume.links.overleaf} title="LaTeX source on Overleaf">
          <span aria-hidden="true">TeX</span>
          <span class="sr-only">Overleaf source</span>
        </a>
        <a href={resume.links.linkedin} title="LinkedIn profile">
          <span aria-hidden="true">in</span>
          <span class="sr-only">LinkedIn</span>
        </a>
      </nav>
      <div class="panel-inner">
        <h2 class="panel-title">Resume</h2>

        <a class="resume-preview" href={resume.links.pdf} title="Open the full-size resume">
          <img
            src="/media/resume-preview.png"
            alt="Preview of Jose Sanchez Gonzalez's one-page resume — click to open the full-size PDF."
            width="1000"
            height="1294"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="meta">Click the page to view full size — or use the floating icons.</p>

        <h2>Summary</h2>
        <p>{resume.summary}</p>

        <h2>Education</h2>
        <ul class="resume-list">
          {
            resume.education.map((e) => (
              <li>
                <div class="project-row">
                  <h3>{e.degree}</h3>
                  <span class="leader" aria-hidden="true" />
                  <span class="meta">{e.when}</span>
                </div>
                <p class="dim">{e.school}</p>
              </li>
            ))
          }
        </ul>

        <h2>Skills</h2>
        <ul class="resume-list">
          {
            resume.skills.map((s) => (
              <li>
                <h3>{s.area}</h3>
                <p class="dim">{s.items}</p>
              </li>
            ))
          }
        </ul>

        <h2>Experience</h2>
        <ul class="resume-list">
          {
            resume.experience.map((job) => (
              <li>
                <div class="project-row">
                  <h3>{job.role}</h3>
                  <span class="leader" aria-hidden="true" />
                  <span class="meta">{job.when}</span>
                </div>
                <p class="dim">{job.org}</p>
                <ul class="resume-bullets">
                  {job.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>

        <h2>Projects</h2>
        <ul class="resume-projects">
          {
            projects.map((p) => (
              <li>
                <a
                  class="resume-thumb"
                  href={`/projects/${p.id}`}
                  aria-hidden="true"
                  tabindex="-1"
                >
                  <img
                    src={p.data.image ?? p.data.poster}
                    alt=""
                    width="320"
                    height="180"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <div>
                  <div class="project-row">
                    <h3>
                      <a href={`/projects/${p.id}`}>{p.data.title}</a>
                    </h3>
                    <span class="leader" aria-hidden="true" />
                    <span class="meta">{p.data.date.getUTCFullYear()}</span>
                  </div>
                  <p class="dim">
                    {p.data.summary} {p.data.result}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  {/* The nav is the section indicator: whichever rectangle is centered
      lights up in that rectangle's own accent. Works for the horizontal
      pager and the stacked mobile layout alike, since it measures each
      panel's center against the viewport's. */}
  <script>
    {
      const panelsEl = document.getElementById("panels");
      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('.site-header nav a[href^="/#"]'),
      );
      if (panelsEl && links.length) {
        const accent: Record<string, string> = {
          about: "blue",
          projects: "red",
          beyond: "blue",
          resume: "red",
        };
        const sections = Array.from(panelsEl.querySelectorAll<HTMLElement>(".panel"));
        let raf = 0;
        const mark = () => {
          raf = 0;
          const cx = window.innerWidth / 2;
          const cy = window.innerHeight / 2;
          let here = "";
          let best = Infinity;
          for (const s of sections) {
            const r = s.getBoundingClientRect();
            const d = Math.hypot((r.left + r.right) / 2 - cx, (r.top + r.bottom) / 2 - cy);
            if (d < best) {
              best = d;
              here = s.id;
            }
          }
          for (const a of links) {
            const id = a.getAttribute("href")!.slice(2);
            if (id === here) a.dataset.here = accent[id] ?? "blue";
            else delete a.dataset.here;
          }
        };
        const queue = () => {
          if (!raf) raf = requestAnimationFrame(mark);
        };
        panelsEl.addEventListener("scroll", queue, { passive: true });
        window.addEventListener("scroll", queue, { passive: true });
        window.addEventListener("resize", queue, { passive: true });
        mark();
      }
    }
  </script>

  {/* Wheel pages between the rectangles; inner scrollers (the project
      carousel, a panel's own vertical overflow) get first claim.

      Two things make this feel smooth rather than sticky. A page is held
      until the scroll actually finishes — `scrollend` where it exists,
      with a timeout as the fallback — instead of an arbitrary 500 ms, so
      short trips release early and long ones are never cut off. And a
      trackpad's momentum tail is ignored: after a page, the wheel has to
      go quiet before it can trigger the next one, so one flick moves one
      rectangle instead of three. */}
  <script>
    const panels = document.getElementById("panels");
    if (panels && window.matchMedia("(pointer: fine)").matches) {
      const sections = Array.from(panels.querySelectorAll<HTMLElement>(".panel"));
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      let paging = false;
      let lastWheel = 0;
      let releaseTimer = 0;

      const release = () => {
        window.clearTimeout(releaseTimer);
        releaseTimer = window.setTimeout(() => {
          // only hand control back once the wheel has actually settled
          if (performance.now() - lastWheel < 120) {
            release();
            return;
          }
          paging = false;
        }, 140);
      };

      const supportsScrollEnd = "onscrollend" in window;
      if (supportsScrollEnd) {
        panels.addEventListener("scrollend", release, { passive: true });
      }

      const pageTo = (index: number) => {
        const el = sections[index];
        if (!el) return;
        paging = true;
        const left = el.offsetLeft - (panels.clientWidth - el.offsetWidth) / 2;
        panels.scrollTo({ left, behavior: reduced ? "auto" : "smooth" });
        // fallback for browsers without scrollend, and a safety net if the
        // smooth scroll is interrupted
        window.clearTimeout(releaseTimer);
        releaseTimer = window.setTimeout(release, reduced ? 80 : 420);
      };

      /** Index of the child whose center is nearest the scroller's center. */
      const nearest = (scroller: HTMLElement, kids: HTMLElement[]) => {
        const mid = scroller.scrollLeft + scroller.clientWidth / 2;
        let best = 0;
        let bestDist = Infinity;
        kids.forEach((s, i) => {
          const d = Math.abs(s.offsetLeft + s.offsetWidth / 2 - mid);
          if (d < bestDist) {
            bestDist = d;
            best = i;
          }
        });
        return best;
      };

      const currentIndex = () => nearest(panels, sections);

      /** Step a horizontal strip one item, landing on its snap point. */
      const stepStrip = (strip: HTMLElement, dir: number) => {
        const kids = Array.from(strip.children) as HTMLElement[];
        if (kids.length === 0) return false;
        const i = nearest(strip, kids);
        const next = Math.min(Math.max(i + dir, 0), kids.length - 1);
        if (next === i) return false;
        const el = kids[next];
        paging = true;
        strip.scrollTo({
          left: el.offsetLeft - (strip.clientWidth - el.offsetWidth) / 2,
          behavior: reduced ? "auto" : "smooth",
        });
        window.clearTimeout(releaseTimer);
        releaseTimer = window.setTimeout(release, reduced ? 80 : 420);
        return true;
      };

      panels.addEventListener(
        "wheel",
        (e) => {
          if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return; // native horizontal gesture
          lastWheel = performance.now();

          // let an inner scroller consume the wheel until it hits its edge.
          // Strips step one item per flick: a raw delta would be dragged
          // back by the snap, and a half-scrolled card looks broken.
          let el = e.target as HTMLElement | null;
          while (el && el !== panels) {
            // "content is taller than the box" is not the same as "the box
            // scrolls" — a panel with hidden overflow would otherwise
            // swallow the wheel and go nowhere
            const style = getComputedStyle(el);
            const scrollsX = /auto|scroll/.test(style.overflowX);
            const scrollsY = /auto|scroll/.test(style.overflowY);

            if (scrollsX && el.scrollWidth > el.clientWidth + 1) {
              const atEnd =
                e.deltaY > 0
                  ? el.scrollLeft + el.clientWidth >= el.scrollWidth - 2
                  : el.scrollLeft <= 1;
              if (!atEnd) {
                e.preventDefault();
                if (!paging && Math.abs(e.deltaY) >= 4) {
                  stepStrip(el, e.deltaY > 0 ? 1 : -1);
                }
                return;
              }
            }
            if (scrollsY && el.scrollHeight > el.clientHeight + 1) {
              const more =
                e.deltaY > 0
                  ? el.scrollTop + el.clientHeight < el.scrollHeight - 1
                  : el.scrollTop > 0;
              if (more) return; // native vertical scroll inside the panel
            }
            el = el.parentElement;
          }

          e.preventDefault();
          if (paging) return;
          if (Math.abs(e.deltaY) < 4) return; // ignore the tail of a glide

          const next = Math.min(
            Math.max(currentIndex() + (e.deltaY > 0 ? 1 : -1), 0),
            sections.length - 1,
          );
          if (next !== currentIndex()) pageTo(next);
        },
        { passive: false },
      );
    }
  </script>
</Base>
